<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProjectSeshat.App.ViewModels"
             x:Class="ProjectSeshat.App.Views.AtlasView"
             x:DataType="vm:AtlasViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="#7DAAC4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.stage-label">
      <Setter Property="Foreground" Value="#36C5F0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="#1C8BC4" />
      <Setter Property="Foreground" Value="#03111B" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#36C5F0" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#36C5F0" />
    </Style>
    <Style Selector="Button.action:pressed">
      <Setter Property="Background" Value="#0F5F82" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.action:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F5F82" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Border Background="#0E1D2E" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="6" Padding="24">
    <Grid ColumnDefinitions="360,*" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="12" Margin="0,0,0,16">
        <TextBlock Classes="section-label" Text="SEARCH GUIDE" />
        <TextBlock Text="{Binding CurrentSystemText}" Foreground="#7FCFB0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SummaryText}" Foreground="#D2EAF7" FontSize="14" TextWrapping="Wrap" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,8,16,0">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="stage-label" Text="1 · NEEDS HONK" />
            <ListBox ItemsSource="{Binding HonkItems}"
                     SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                     MaxHeight="120"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10" Background="#08111D" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" Foreground="#E5F5FF" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Text="{Binding Subtitle}" Foreground="#83B8D5" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="stage-label" Text="2 · NEEDS FSS" />
            <ListBox ItemsSource="{Binding FssItems}"
                     SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                     MaxHeight="150"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10" Background="#08111D" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" Foreground="#E5F5FF" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Text="{Binding Subtitle}" Foreground="#83B8D5" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="stage-label" Text="3 · NEEDS DSS" />
            <ListBox ItemsSource="{Binding DssItems}"
                     SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                     MaxHeight="150"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10" Background="#08111D" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" Foreground="#E5F5FF" FontWeight="SemiBold" FontSize="13" />
                      <TextBlock Text="{Binding Subtitle}" Foreground="#83B8D5" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Spacing="16" Margin="24,0,0,0">
        <TextBlock Classes="section-label" Text="FOCUS" />
        <Border Background="#06221A" BorderBrush="#2C8F6E" BorderThickness="1" CornerRadius="6" Padding="20">
          <StackPanel Spacing="8">
            <TextBlock Classes="stage-label" Text="CURRENT POSITION" />
            <TextBlock Text="{Binding CurrentSystemText}" Foreground="#E5F5FF" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Background="#08111D" BorderBrush="#36C5F0" BorderThickness="1" CornerRadius="6" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Classes="stage-label" Text="NEXT JUMP — PLOT A ROUTE" />
            <TextBlock Text="{Binding NextJumpTitle}" Foreground="#E5F5FF" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding NextJumpDetail}" Foreground="#D2EAF7" FontSize="14" TextWrapping="Wrap" LineHeight="20" />
          </StackPanel>
        </Border>
        <Border Background="#08111D" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="6" Padding="20">
          <StackPanel Spacing="16">
            <TextBlock Text="{Binding SelectedTargetTitle}" Foreground="#E5F5FF" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedTargetDetail}" Foreground="#D2EAF7" FontSize="14" TextWrapping="Wrap" LineHeight="20" />
            <Border Height="1" Background="#1A4D67" Margin="0,8" />
            <TextBlock Text="The guide works in order: honk everywhere, FSS systems the honk flagged, then DSS only the bodies that turned out worth surface-mapping. The honk list is your jump route, ordered nearest-first from where you are now. It updates automatically as your journal files change." Foreground="#83B8D5" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
