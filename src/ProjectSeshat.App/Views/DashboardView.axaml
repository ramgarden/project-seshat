<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProjectSeshat.App.ViewModels"
             x:Class="ProjectSeshat.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <UserControl.Styles>
    <Style Selector="Border.stat-card">
      <Setter Property="Background" Value="#0E1D2E" />
      <Setter Property="BorderBrush" Value="#1A4D67" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="#7DAAC4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="Button.toggle">
      <Setter Property="Background" Value="#1C8BC4" />
      <Setter Property="Foreground" Value="#03111B" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toggle:pointerover">
      <Setter Property="Background" Value="#36C5F0" />
    </Style>
    <Style Selector="Button.toggle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#36C5F0" />
    </Style>
    <Style Selector="Button.toggle:pressed">
      <Setter Property="Background" Value="#0F5F82" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.toggle:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F5F82" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto" Margin="0,0,12,0">
    <ScrollViewer Grid.Row="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="18">
        <Border Background="#0E1D2E" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="6" Padding="24" VerticalAlignment="Top" Margin="0,0,0,20">
          <StackPanel Spacing="18">
            <TextBlock Classes="section-label" Text="{Binding StatisticsHeading}" />

            <!-- Row 1: Systems / Commanders / Evidence -->
            <Grid ColumnDefinitions="*,18,*,18,*">
              <Border Classes="stat-card" Grid.Column="0">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-label" Text="{Binding SystemsIndexedLabel}" />
                  <TextBlock Text="{Binding SystemsIndexedCount}" FontSize="36" FontWeight="Light" Foreground="#E5F5FF" />
                </StackPanel>
              </Border>
              <Border Classes="stat-card" Grid.Column="2">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-label" Text="{Binding CommanderRecordsLabel}" />
                  <TextBlock Text="{Binding CommanderRecordsCount}" FontSize="36" FontWeight="Light" Foreground="#E5F5FF" />
                </StackPanel>
              </Border>
              <Border Classes="stat-card" Grid.Column="4">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-label" Text="{Binding EvidenceRecordsLabel}" />
                  <TextBlock Text="{Binding EvidenceRecordsCount}" FontSize="36" FontWeight="Light" Foreground="#E5F5FF" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Row 2: Bodies / Codex / Observations -->
            <Grid ColumnDefinitions="*,18,*,18,*" Margin="0,4,0,0">
              <Border Classes="stat-card" Grid.Column="0">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-label" Text="{Binding BodiesIndexedLabel}" />
                  <TextBlock Text="{Binding BodiesIndexedCount}" FontSize="36" FontWeight="Light" Foreground="#7FCFB0" />
                </StackPanel>
              </Border>
              <Border Classes="stat-card" Grid.Column="2">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-label" Text="{Binding CodexEntriesLabel}" />
                  <TextBlock Text="{Binding CodexEntriesCount}" FontSize="36" FontWeight="Light" Foreground="#7FCFB0" />
                </StackPanel>
              </Border>
              <Border Classes="stat-card" Grid.Column="4">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-label" Text="{Binding ObservationsLabel}" />
                  <TextBlock Text="{Binding ObservationsCount}" FontSize="36" FontWeight="Light" Foreground="#7FCFB0" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Row 3: Beacons -->
            <Grid ColumnDefinitions="*,18,*,18,*" Margin="0,4,0,0">
              <Border Classes="stat-card" Grid.Column="0">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-label" Text="{Binding BeaconsIndexedLabel}" />
                  <TextBlock Text="{Binding BeaconCount}" FontSize="36" FontWeight="Light" Foreground="#E5F5FF" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Live Ingestion Panel -->
        <Border Background="#0E1D2E" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="6" Padding="18">
          <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Ellipse Width="10" Height="10" Fill="#36C5F0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="#D2EAF7" FontSize="15" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding JournalPathStatus}" Foreground="#83B8D5" FontSize="13" TextWrapping="Wrap" />
        <TextBlock Text="{Binding LoadingProgress}" Foreground="#7DAAC4" FontSize="13" />
        <TextBlock Text="{Binding ActiveFileName}" Foreground="#A8D4EA" FontSize="13" TextWrapping="Wrap" />

        <Border Height="1" Background="#1A4D67" Margin="0,4" />

        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding CommunityAvailable}">
          <Ellipse Width="10" Height="10" Fill="{Binding CommunityStatusColor}" VerticalAlignment="Center" />
          <TextBlock Classes="section-label" Text="COMMUNITY DATA" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CommunityStatusText}" Foreground="#D2EAF7" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Classes="toggle" Command="{Binding ToggleCommunityCommand}">
            <TextBlock Text="{Binding CommunityToggleText}" />
          </Button>
          <Button Classes="toggle" Command="{Binding ResetDatabaseCommand}" Background="#8B3A3A" Foreground="#FFE0E0">
            <Button.Styles>
              <Style Selector="Button.toggle:pointerover">
                <Setter Property="Background" Value="#B04A4A" />
              </Style>
              <Style Selector="Button.toggle:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#B04A4A" />
              </Style>
              <Style Selector="Button.toggle:pressed">
                <Setter Property="Background" Value="#6B2A2A" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Style>
              <Style Selector="Button.toggle:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="#6B2A2A" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Style>
            </Button.Styles>
            <TextBlock Text="Reset Database" />
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding CommunityDiscoverySummary}" Foreground="#7FCFB0" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding CommunityAvailable}" />
        <TextBlock Text="Stream live, crowdsourced discoveries from EDDN to see where the wider playerbase is and has been — invaluable for the Raxxla hunt." Foreground="#83B8D5" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding CommunityAvailable}" />
        <ItemsControl ItemsSource="{Binding CommunityRecentDiscoveries}" IsVisible="{Binding HasCommunityDiscoveries}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#0A1B2B" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,6">
                <TextBlock Text="{Binding}" Foreground="#A8D4EA" FontSize="12" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding CommunityErrorText}" Foreground="#FF8F8F" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasCommunityError}" />
      </StackPanel>
    </Border>
  </StackPanel>
</ScrollViewer>
</Grid>
</UserControl>
