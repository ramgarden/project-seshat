<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProjectSeshat.App.ViewModels"
             x:Class="ProjectSeshat.App.Views.ExplorationView"
             x:DataType="vm:ExplorationViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="#7DAAC4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0,0,0,8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Background" Value="#1C8BC4" />
      <Setter Property="Foreground" Value="#03111B" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.action:pointerover">
      <Setter Property="Background" Value="#36C5F0" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#36C5F0" />
    </Style>
    <Style Selector="Button.action:pressed">
      <Setter Property="Background" Value="#0F5F82" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.action:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F5F82" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Border Background="#0E1D2E" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="6" Padding="24">
    <Grid ColumnDefinitions="340,*" RowDefinitions="Auto,*">
      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="12" Margin="0,0,0,16">
        <TextBlock Classes="section-label" Text="EXPLORATION" />
        <TextBlock Text="{Binding ExplorationSummary}" Foreground="#D2EAF7" FontSize="14" TextWrapping="Wrap" />
      </StackPanel>

      <ListBox Grid.Row="1" Grid.Column="0" Margin="0,8,16,0"
               ItemsSource="{Binding ExploreItems}"
               SelectedItem="{Binding SelectedExploreItem, Mode=TwoWay}"
               SelectionMode="Single"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="12" Background="#08111D" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="4" Margin="0,0,0,4">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding SystemName}" Foreground="#E5F5FF" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding Detail}" Foreground="#83B8D5" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="24,0,0,0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <TextBlock Classes="section-label" Text="FOCUS" />
          <Border Background="#08111D" BorderBrush="#1A4D67" BorderThickness="1" CornerRadius="6" Padding="20">
            <StackPanel Spacing="16">
              <TextBlock Text="{Binding SelectedExploreItemTitle}" Foreground="#E5F5FF" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedExploreItemDetail}" Foreground="#D2EAF7" FontSize="14" TextWrapping="Wrap" LineHeight="20" />
              <Border Height="1" Background="#1A4D67" Margin="0,8" />
              <TextBlock Text="{Binding SelectedBodyStatus}" Foreground="#D2EAF7" FontSize="13" TextWrapping="Wrap" />
              <ListBox ItemsSource="{Binding SelectedSystemBodies}"
                       SelectedItem="{Binding SelectedBody, Mode=TwoWay}"
                       MaxHeight="220"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4">
                      <TextBlock Text="{Binding Label}" Foreground="#E5F5FF" FontSize="13" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Distance}" Foreground="#83B8D5" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ScanLabel}" Foreground="#36C5F0" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="{Binding NeedsDssSummary}" Foreground="#83B8D5" FontSize="13" TextWrapping="Wrap" />
              <Border Height="1" Background="#1A4D67" Margin="0,8" />
              <TextBlock Text="Scan progress comes straight from your journal files. A body is listed once the honk detects it, upgraded when you FSS it, and marked mapped automatically when a Detailed Surface Scanner pass completes." Foreground="#83B8D5" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
