<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ProjectSeshat.App.MainWindow"
        Width="1120"
        Height="720"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#08111D"
        Title="{Binding WindowTitle}">
  <Window.Styles>
    <!-- Navigation buttons: every state sets an explicit, high-contrast color so the
         Fluent theme's default (light) hover can never hide the light text. -->
    <Style Selector="Button.nav-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9CC5DE" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.1" />
          <BrushTransition Property="Foreground" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav-btn:pointerover">
      <Setter Property="Background" Value="#22405A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22405A" />
    </Style>
    <Style Selector="Button.nav-btn:pressed">
      <Setter Property="Background" Value="#154F70" />
      <Setter Property="Foreground" Value="#EAF7FF" />
    </Style>
    <Style Selector="Button.nav-btn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#154F70" />
    </Style>
    <Style Selector="Button.nav-btn.active">
      <Setter Property="Background" Value="#1C8BC4" />
      <Setter Property="Foreground" Value="#02101B" />
    </Style>
    <Style Selector="Button.nav-btn.active:pointerover">
      <Setter Property="Background" Value="#2FA9DB" />
      <Setter Property="Foreground" Value="#02101B" />
    </Style>
    <Style Selector="Button.nav-btn.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2FA9DB" />
    </Style>
    <Style Selector="Button.nav-btn.active:pressed">
      <Setter Property="Background" Value="#154F70" />
      <Setter Property="Foreground" Value="#EAF7FF" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="260,*">
    <!-- Sidebar Navigation -->
    <Border Grid.Column="0" Background="#0A1626" BorderBrush="#1A4D67" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="24,40">
        <!-- Logo and Platform Branding -->
        <StackPanel Grid.Row="0" Spacing="6">
          <TextBlock Text="{Binding ProjectName}"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="#E5F5FF"
                     LetterSpacing="1.5" />
          <TextBlock Text="{Binding PlatformName}"
                     FontSize="12"
                     Foreground="#83B8D5" />
          <Border Height="2" Width="48" Margin="0,16,0,0" HorizontalAlignment="Left" Background="#36C5F0" />
        </StackPanel>

        <!-- Navigation Options -->
        <StackPanel Grid.Row="1" Margin="0,48,0,0" Spacing="8">
          <Button Classes="nav-btn"
                  Classes.active="{Binding IsDashboardActive}"
                  Command="{Binding NavigateToDashboardCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" Width="16" Height="16" />
              <TextBlock Text="Dashboard" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav-btn"
                  Classes.active="{Binding IsSearchGuideActive}"
                  Command="{Binding NavigateToSearchGuideCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.41 16.09V20h-2.67v-1.93c-1.71-.36-3.16-1.46-3.27-3.4h1.96c.1 1.05.82 1.87 2.65 1.87 1.96 0 2.4-.98 2.4-1.59 0-.83-.44-1.61-2.67-2.14-2.48-.6-4.18-1.62-4.18-3.67 0-1.72 1.39-2.84 3.11-3.21V4h2.67v1.95c1.86.45 2.79 1.86 2.85 3.39H14.3c-.05-1.11-.64-1.87-2.22-1.87-1.5 0-2.4.68-2.4 1.64 0 .84.65 1.39 2.67 1.91s4.16 1.63 4.16 3.91c-.01 1.75-1.38 2.89-3.1 3.16z" Width="16" Height="16" />
              <TextBlock Text="Search Guide" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav-btn"
                  Classes.active="{Binding IsSurveyActive}"
                  Command="{Binding NavigateToSurveyCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h2v-2H7v2zm0-4h2V7H7v2zm0 8h2v-2H7v2zm4-4h2v-2h-2v2zm0-4h2V7h-2v2zm0 8h2v-2h-2v2zm4-4h2v-2h-2v2zm0-4h2V7h-2v2zm4-4v2h2V7h-2zm0 8h2v-2h-2v2z" Width="16" Height="16" />
              <TextBlock Text="Atlas Survey" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav-btn"
                  Classes.active="{Binding IsGalaxyMapActive}"
                  Command="{Binding NavigateToGalaxyMapCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-.35 17.9c-.78.06-1.45-.58-1.45-1.36 0-1.72 1.39-3.54 4-3.54.62 0 1.1-.48 1.1-1.1s-.48-1.1-1.1-1.1H12c-4.13 0-8-3.31-8-8 0-3.23 2.52-5.72 5.6-5.9.72-.05 1.48.48 1.48 1.2 0 1.7-1.48 2.7-3.58 2.7-.66 0-1.2.54-1.2 1.2s.54 1.2 1.2 1.2H18c3.04 0 5.5 2.46 5.5 5.5-.01 5.06-5.42 5.83-6.35 6.22.8-.12 1.4-1.09 1.4-2.22 0-.4-.16-.79-.43-1.08.16-2.13 1.42-4.09 2.89-5.42h-1.63c-.55 0-1.3-.08-1.72-.29.6.69.42 1.8-.42 2.4-.86.61-2.12 1.32-2.12 2.42 0 1.1.9 1.9 1.9 1.9h3.53c-1.3.86-4.41 1.14-5.1 1.01z" Width="16" Height="16" />
              <TextBlock Text="Galaxy Map" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav-btn"
                  Classes.active="{Binding IsExplorationActive}"
                  Command="{Binding NavigateToExplorationCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" Width="16" Height="16" />
              <TextBlock Text="Exploration" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="nav-btn"
                  Classes.active="{Binding IsThreadsActive}"
                  Command="{Binding NavigateToThreadsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="M11 15h2v-2h-2v2zm0-6h2V5h-2v4zm1 13c-5.52 0-10-4.48-10-10S6.48 2 12 2s10 4.48 10 10-4.48 10-10 10zm0-18c-4.41 0-8 3.59-8 8s3.59 8 8 8 8-3.59 8-8-3.59-8-8-8z" Width="16" Height="16" />
              <TextBlock Text="Research Threads" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Spacing="8">
          <Button Classes="nav-btn" Command="{Binding TestGuidanceCommand}" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" Width="16" Height="16" />
              <TextBlock Text="Test guidance" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav-btn" Command="{Binding ToggleOverlayCommand}" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" Width="16" Height="16" />
              <TextBlock Text="{Binding OverlayVisibilityText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav-btn" Command="{Binding SpeakNowCommand}" HorizontalAlignment="Stretch" IsVisible="{Binding VoiceAvailable}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <PathIcon Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" Width="16" Height="16" />
              <TextBlock Text="Speak next step" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Text="v0.9.0-alpha" Foreground="#47738C" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Workspace Content -->
    <Grid Grid.Column="1" Margin="40">
      <ContentControl Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
